# PCPartsBuild - Main .gitignore

# --- IDEs & Editors ---
.vs/
.idea/
.vscode/
*.user
*.suo
*.sln.dotSettings.user
*.csproj.user

# --- Windows / OS Specific ---
Thumbs.db
.DS_Store

# --- .NET (Backend) ---
**/bin/
**/obj/
**/Debug/
**/Release/
**/publish/
*.pdb
*.dll
*.exe
*.cache
*.nupkg
packages/
# We keep appsettings templates, but ignore actual config with secrets
appsettings.json
appsettings.Development.json
PCPartsAPI.http
PCPartsBuild-Backend/build_output*.txt

# --- Node.js / React (Frontend) ---
**/node_modules/
**/.next/
**/out/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/*.tsbuildinfo
next-env.d.ts

# --- Environment & Sensitive Files ---
# NEVER COMMIT THESE TO GITHUB!
**/.env*
**/*.pem
**/*.pfx
**/*.p12
**/*.key
**/*.cert
**/*.crt
**/secrets.json
**/secret.settings.json

# --- Project Specific ---
PCPartsBuild-Frontend-Old/
tailwindcss.exe
api.txt
package-lock.json

# --- Others ---
*.tmp
*.temp
*.log
*.db
*.db-wal
*.db-shm